---
# YAML Lint Configuration for Ansible
extends: default

rules:
  braces:
    max-spaces-inside: 1
    level: error
  brackets:
    max-spaces-inside: 1
    level: error
  colons:
    max-spaces-after: -1
    level: error
  commas:
    max-spaces-after: -1
    level: error
  comments: disable
  comments-indentation: disable
  document-start: disable  # Ansible files don't always start with ---
  empty-lines:
    max: 1
    level: error
  hyphens:
    level: error
  indentation:
    spaces: 2
    indent-sequences: true
    check-multi-line-strings: false
  key-duplicates: enable
  line-length: disable
  new-line-at-end-of-file: disable  # Some Ansible files don't need this
  new-lines:
    type: unix
  trailing-spaces: enable
  truthy:
    level: warning  # Allow yes/no for Ansible (standard practice)
    allowed-values:
      - 'true'
      - 'false'
      - 'yes'
      - 'no'
      - 'on'
      - 'off'

yaml-files:
  - '*.yml'
  - '*.yaml'
  - '.yamllint'
