# Dockerfile for testing the playbook
# Usage: docker build -f Dockerfile.test -t devops-test .
#        docker run -it --rm -v $(pwd):/workspace -w /workspace devops-test bash

FROM ubuntu:22.04

# Avoid interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

# Install prerequisites
RUN apt-get update && \
    apt-get install -y \
    git \
    ansible \
    python3 \
    python3-pip \
    sudo \
    curl \
    wget \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Create a non-root user for testing with sudo access
RUN useradd -m -s /bin/bash tester && \
    echo "tester ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers && \
    usermod -aG sudo tester

# Set working directory
WORKDIR /workspace

# Keep as root for testing (playbook needs root access)
# USER tester

# Default command
CMD ["/bin/bash"]

